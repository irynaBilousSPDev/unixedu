{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unixedu/commission-table",
  "title": "Commission Table",
  "category": "unixedu",
  "icon": "table-col-after",
  "description": "Section header + 4-column commission table with flexible rows.",
  "textdomain": "unixedu",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true
  },
  "attributes": {
    "background": { "type": "string", "default": "white" },
    "eyebrow": { "type": "string", "default": "" },
    "titleLine1": { "type": "string", "default": "" },
    "titleLine1Style": { "type": "string", "default": "default" },
    "titleLine2": { "type": "string", "default": "" },
    "titleLine2Style": { "type": "string", "default": "default" },
    "titleLine3": { "type": "string", "default": "" },
    "titleLine3Style": { "type": "string", "default": "default" },
    "footnote": {
      "type": "string",
      "default": "*Based on EUR 600 net commission per student (EUR 3,000 programme fee × 20% university rate). Tiers are cumulative per academic year."
    },
    "rows": { "type": "array", "default": [] }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

