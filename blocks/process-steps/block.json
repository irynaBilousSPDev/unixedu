{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unixedu/process-steps",
  "title": "Process Steps",
  "category": "unixedu",
  "icon": "editor-ol",
  "description": "Universal process/steps section with 4 step cards.",
  "textdomain": "unixedu",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true
  },
  "attributes": {
    "backgroundMode": { "type": "string", "default": "light-gray" },
    "backgroundImageId": { "type": "number", "default": 0 },
    "backgroundImageUrl": { "type": "string", "default": "" },
    "backgroundImageAlt": { "type": "string", "default": "" },
    "overlayOpacity": { "type": "number", "default": 0.55 },
    "cardType": { "type": "string", "default": "numbers" },
    "cardsLayout": { "type": "string", "default": "four-columns" },
    "cardsSurface": { "type": "string", "default": "transparent" },
    "contentTone": { "type": "string", "default": "auto" },
    "headingLayout": { "type": "string", "default": "default" },
    "titleStyleMode": { "type": "string", "default": "normal" },

    "eyebrow": { "type": "string", "default": "" },
    "showUnderline": { "type": "boolean", "default": false },
    "titleLine1": { "type": "string", "default": "" },
    "titleLine1Style": { "type": "string", "default": "default" },
    "titleLine2": { "type": "string", "default": "" },
    "titleLine2Style": { "type": "string", "default": "default" },
    "titleLine3": { "type": "string", "default": "" },
    "titleLine3Style": { "type": "string", "default": "default" },
    "introText": { "type": "string", "default": "" },

    "step1Number": { "type": "string", "default": "01" },
    "step1Tier": { "type": "string", "default": "TIER 1" },
    "step1Title": { "type": "string", "default": "" },
    "step1BadgeText": { "type": "string", "default": "" },
    "step1BadgeStyle": { "type": "string", "default": "dark" },
    "step1Text": { "type": "string", "default": "" },
    "step1LinkText": { "type": "string", "default": "" },
    "step1LinkUrl": { "type": "string", "default": "" },

    "step2Number": { "type": "string", "default": "02" },
    "step2Tier": { "type": "string", "default": "TIER 2" },
    "step2Title": { "type": "string", "default": "" },
    "step2BadgeText": { "type": "string", "default": "" },
    "step2BadgeStyle": { "type": "string", "default": "dark" },
    "step2Text": { "type": "string", "default": "" },
    "step2LinkText": { "type": "string", "default": "" },
    "step2LinkUrl": { "type": "string", "default": "" },

    "step3Number": { "type": "string", "default": "03" },
    "step3Tier": { "type": "string", "default": "TIER 3" },
    "step3Title": { "type": "string", "default": "" },
    "step3BadgeText": { "type": "string", "default": "" },
    "step3BadgeStyle": { "type": "string", "default": "dark" },
    "step3Text": { "type": "string", "default": "" },
    "step3LinkText": { "type": "string", "default": "" },
    "step3LinkUrl": { "type": "string", "default": "" },

    "step4Number": { "type": "string", "default": "04" },
    "step4Tier": { "type": "string", "default": "TIER 4" },
    "step4Title": { "type": "string", "default": "" },
    "step4BadgeText": { "type": "string", "default": "" },
    "step4BadgeStyle": { "type": "string", "default": "dark" },
    "step4Text": { "type": "string", "default": "" },
    "step4LinkText": { "type": "string", "default": "" },
    "step4LinkUrl": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

