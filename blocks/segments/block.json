{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unixedu/segments",
  "title": "Segments",
  "category": "unixedu",
  "icon": "grid-view",
  "description": "Section header + 4 segment cards.",
  "textdomain": "unixedu",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true
  },
  "attributes": {
    "background": { "type": "string", "default": "white" },
    "eyebrow": { "type": "string", "default": "" },
    "titleLine1": { "type": "string", "default": "" },
    "titleLine1Style": { "type": "string", "default": "default" },
    "titleLine2": { "type": "string", "default": "" },
    "titleLine2Style": { "type": "string", "default": "default" },
    "titleLine3": { "type": "string", "default": "" },
    "titleLine3Style": { "type": "string", "default": "default" },
    "cards": { "type": "array", "default": [] }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

