{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unixedu/media-cta",
  "title": "Media CTA",
  "category": "unixedu",
  "icon": "align-pull-right",
  "description": "Image + header + text + button section with flexible background.",
  "textdomain": "unixedu",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true
  },
  "attributes": {
    "backgroundMode": { "type": "string", "default": "white" },
    "backgroundImageId": { "type": "number", "default": 0 },
    "backgroundImageUrl": { "type": "string", "default": "" },
    "backgroundImageAlt": { "type": "string", "default": "" },
    "backgroundPosition": { "type": "string", "default": "center" },

    "contentPlacement": { "type": "string", "default": "right" },

    "eyebrow": { "type": "string", "default": "" },
    "titleLine1": { "type": "string", "default": "" },
    "titleLine1Style": { "type": "string", "default": "default" },
    "titleLine2": { "type": "string", "default": "" },
    "titleLine2Style": { "type": "string", "default": "default" },
    "titleLine3": { "type": "string", "default": "" },
    "titleLine3Style": { "type": "string", "default": "default" },
    "text": { "type": "string", "default": "" },

    "buttonText": { "type": "string", "default": "" },
    "buttonUrl": { "type": "string", "default": "" },
    "buttonStyle": { "type": "string", "default": "lime" }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

