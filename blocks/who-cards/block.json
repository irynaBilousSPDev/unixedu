{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unixedu/who-cards",
  "title": "Audience Cards",
  "category": "unixedu",
  "icon": "screenoptions",
  "description": "Universal 3-card section (light/dark card styles).",
  "textdomain": "unixedu",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true
  },
  "attributes": {
    "background": { "type": "string", "default": "white" },
    "eyebrow": { "type": "string", "default": "" },
    "titleLine1": { "type": "string", "default": "" },
    "titleLine2": { "type": "string", "default": "" },
    "text": {
      "type": "string",
      "default": ""
    },
    "showEyebrowUnderline": { "type": "boolean", "default": false },

    "card1Type": { "type": "string", "default": "light" },
    "card1Eyebrow": { "type": "string", "default": "" },
    "card1Title": { "type": "string", "default": "" },
    "card1Text": { "type": "string", "default": "" },
    "card1ButtonText": { "type": "string", "default": "" },
    "card1ButtonUrl": { "type": "string", "default": "" },
    "card1SmallUrlText": { "type": "string", "default": "" },

    "card2Type": { "type": "string", "default": "dark" },
    "card2Eyebrow": { "type": "string", "default": "" },
    "card2Title": { "type": "string", "default": "" },
    "card2Text": { "type": "string", "default": "" },
    "card2ButtonText": { "type": "string", "default": "" },
    "card2ButtonUrl": { "type": "string", "default": "" },
    "card2SmallUrlText": { "type": "string", "default": "" },

    "card3Type": { "type": "string", "default": "light" },
    "card3Eyebrow": { "type": "string", "default": "" },
    "card3Title": { "type": "string", "default": "" },
    "card3Text": { "type": "string", "default": "" },
    "card3ButtonText": { "type": "string", "default": "" },
    "card3ButtonUrl": { "type": "string", "default": "" },
    "card3SmallUrlText": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

