{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unixedu/hero",
  "title": "Hero",
  "category": "unixedu",
  "icon": "cover-image",
  "description": "Hero section (Unixedu).",
  "textdomain": "unixedu",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true
  },
  "attributes": {
    "variant": { "type": "string", "default": "home" },
    "theme": { "type": "string", "default": "light" },
    "showBreadcrumbs": { "type": "boolean", "default": false },
    "breadcrumbLabel": { "type": "string", "default": "" },
    "breadcrumbParentLabel": { "type": "string", "default": "" },
    "breadcrumbParentUrl": { "type": "string", "default": "" },
    "eyebrow": { "type": "string", "default": "" },
    "eyebrowStyle": { "type": "string", "default": "default" },
    "titleLine1": { "type": "string", "default": "" },
    "titleLine1Style": { "type": "string", "default": "default" },
    "titleLine2": { "type": "string", "default": "" },
    "titleLine2Style": { "type": "string", "default": "default" },
    "titleLine3": { "type": "string", "default": "" },
    "titleLine3Style": { "type": "string", "default": "default" },
    "titleLine4": { "type": "string", "default": "" },
    "titleLine4Style": { "type": "string", "default": "default" },
    "titleStyle": { "type": "string", "default": "default" },
    "highlightMode": { "type": "string", "default": "limeOnDark" },
    "highlightLine": { "type": "number", "default": 1 },
    "text": {
      "type": "string",
      "default": ""
    },
    "primaryButtonText": { "type": "string", "default": "" },
    "primaryButtonUrl": { "type": "string", "default": "" },
    "primaryButtonStyle": { "type": "string", "default": "lime" },
    "secondaryButtonText": { "type": "string", "default": "" },
    "secondaryButtonUrl": { "type": "string", "default": "" },
    "secondaryButtonStyle": { "type": "string", "default": "dark" },
    "showSecondaryButton": { "type": "boolean", "default": false },
    "heroImageId": { "type": "number", "default": 0 },
    "heroImageUrl": { "type": "string", "default": "" },
    "heroImageAlt": { "type": "string", "default": "" },
    "showSymbolOverlay": { "type": "boolean", "default": false },
    "showStats": { "type": "boolean", "default": false },
    "stat1Value": { "type": "string", "default": "" },
    "stat1Label": { "type": "string", "default": "" },
    "stat2Value": { "type": "string", "default": "" },
    "stat2Label": { "type": "string", "default": "" },
    "stat3Value": { "type": "string", "default": "" },
    "stat3Label": { "type": "string", "default": "" },
    "stat4Value": { "type": "string", "default": "" },
    "stat4Label": { "type": "string", "default": "" },
    "statsCount": { "type": "number", "default": 3 },
    "statsBottomOffset": { "type": "number", "default": -80 }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}

